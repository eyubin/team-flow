# Copy to .env (never commit .env)

POSTGRES_DB=teamflow
POSTGRES_USER=teamflow
POSTGRES_PASSWORD=teamflow
POSTGRES_PORT=5432

BACKEND_PORT=8080
FRONTEND_PORT=3000

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Generate unique values before any non-local deployment. These are local placeholders, not secrets.
JWT_ACCESS_SECRET=local-dev-access-secret-change-me-32chars
JWT_REFRESH_SECRET=local-dev-refresh-secret-change-me-32ch
